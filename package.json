{
  "name": "browserx",
  "version": "0.1.8",
  "description": "左侧 Claude Code 助手，右侧浏览器",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/dev-app-name.js",
    "start": "electron .",
    "predebug": "node scripts/dev-app-name.js",
    "debug": "electron . --remote-debugging-port=9334"
  },
  "build": {
    "appId": "com.browserx.app",
    "productName": "BrowserX",
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "files": [
      "**/*",
      "!node_modules/@img/**",
      "!**/*.bak*",
      "!*.bak-*",
      "!CLAUDE.md",
      "!scripts/**",
      "!logo.svg",
      "!dist/**",
      "!package-lock.json",
      "!build/win-git/**",
      "!android/**",
      "!.github/**",
      "!README.md"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "EVERGREEN FAMILY OFFICE LIMITED (77L5U5LVW4)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "BrowserX ${version}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/win-git",
          "to": "git",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BrowserX",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "BrowserX",
        "schemes": [
          "browserx"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://browserx.xingke888.com/updates/"
      }
    ],
    "electronLanguages": [
      "zh_CN",
      "zh_TW",
      "en",
      "ja",
      "ko",
      "fr",
      "de",
      "es"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "electron-updater": "6.8.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8"
  }
}
